NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_your_publishable_key

# Server-only. Never expose this value to the browser or commit a real key.
NUXT_SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Server-only recap generation providers.
TRAKT_CLIENT_ID=your_trakt_client_id
OPENAI_API_KEY=sk-your_openai_api_key

# Optional enrichment. Configure one TMDB authentication method.
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token
# TMDB_API_KEY=your_tmdb_v3_api_key

# Quality-first default. Override this after comparing cost, latency and quality
# on the project's recap evaluation set.
OPENAI_RECAP_MODEL=gpt-5.6
