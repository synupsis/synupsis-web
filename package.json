{
  "name": "synupsis-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "audit:dependencies": "yarn audit",
    "build": "nuxt build",
    "dev": "nuxt dev --port 3001",
    "eval:recaps": "node --env-file=.env scripts/evaluate-recaps.mjs",
    "generate": "nuxt generate",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:pipeline": "node --test .github/scripts/*.test.mjs",
    "test-accounts": "node --env-file=.env scripts/create-test-accounts.mjs",
    "typecheck": "nuxt typecheck",
    "types:supabase": "supabase gen types typescript --linked > types/generated/database.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxtjs/supabase": "^2.0.9",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "nuxt": "^4.6.3",
    "postcss": "^8.4.31",
    "prettier": "3.1.1",
    "supabase": "2.109.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.8.3",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^13.9.0",
    "konva": "^9.3.20",
    "lucide-vue-next": "^0.525.0",
    "openai": "^5.8.2",
    "reka-ui": "^2.5.1",
    "shadcn-nuxt": "^2.8.0",
    "vue-konva": "^3.2.1",
    "vue-sonner": "^2.0.1",
    "vuedraggable": "^4.1.0"
  },
  "resolutions": {
    "**/@rollup/plugin-node-resolve/deepmerge": "file:.github/vendor/rollup-defaults-clone",
    "**/minimatch": "11.0.1",
    "**/workbox-build/glob": "14.0.2",
    "**/@vercel/nft/glob": "14.0.2",
    "**/archiver-utils/glob": "14.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
